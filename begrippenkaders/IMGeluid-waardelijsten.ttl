   skos:definition "Categorie-indeling van de bovenbouw."@nl ;
   skos:scopeNote "\n                        Een geospoortak kan in SoundBase verschillende bovenbouwcodes hebben.\n                        De in te voeren bovenbouwcode is afhankelijk van de boring, dwarsliggertype, spoorstaafbevestiging, ballastdikte en de eventuele aanwezigheid van raildempers.\n                        De combinatie van voorgaande factoren resulteert in een bijbehorende bovenbouwklasse.\n                     "@nl ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/1> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/2> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/3> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/4> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/5> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/6> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/7> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/8> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/9> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/10> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/11> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/12> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/13> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/14> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/15> ;
   skos:member <http://definities.geostandaarden.nl/img/id/concept/16> ;
.

